# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production_min_32_chars

# ── Weather (choose one) ──────────────────────────────────────────────────────
# Option 1: Open-Meteo — FREE, no key needed (default)
WEATHER_SOURCE=open-meteo

# Option 2: DWD via BrightSky — FREE, no key needed, German locations only
# WEATHER_SOURCE=dwd

# Option 3: OpenWeatherMap — requires free API key from openweathermap.org
# WEATHER_SOURCE=openweathermap
# WEATHER_API_KEY=your_openweathermap_api_key

# ── Events (choose one) ───────────────────────────────────────────────────────
# Option 1: OSM Overpass — FREE, no key needed (default)
# EVENTS_SOURCE=overpass

# Option 2: Eventbrite — requires API key from eventbrite.com
EVENTS_SOURCE=eventbrite
EVENTBRITE_API_KEY=your_eventbrite_api_key
EVENTBRITE_PRIVATE_TOKEN=your_eventbrite_private_token

# ── Holidays ──────────────────────────────────────────────────────────────────
# Nager.Date — FREE, no key needed
HOLIDAY_COUNTRY_CODE=DE

# ── LLM / Ollama ──────────────────────────────────────────────────────────────
# Ollama runs locally — FREE, no API key
# Options: qwen3:1.7b | phi3 | gemma2 | llama3.2
OLLAMA_MODEL=qwen3:1.7b

# ── Features ──────────────────────────────────────────────────────────────────
CASHBACK_MODE=false

# ── Mobile App ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_MERCHANT_ID=merchant-001
